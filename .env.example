# ========================================================
# JY Career Agent - Environment Variables & Secrets Configuration
# ========================================================
# Copy this file to .env and configure your local credentials.
# NEVER commit real credentials or .env files to git!

# --- ASP.NET Core Runtime ---
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5000

# --- Email / SMTP Secrets ---
# For Gmail, generate an App Password from your Google Account (Security -> 2-Step Verification -> App Passwords)
JY_EMAIL__SMTP_PASSWORD=your_gmail_app_password_here
JY_EMAIL__SMTP_USERNAME=jibrankhalily@gmail.com
JY_EMAIL__SMTP_HOST=smtp.gmail.com
JY_EMAIL__SMTP_PORT=587

# --- AI LLM Providers ---
# Provider options: TemplateEngine (built-in offline, no key required), OpenAI, AzureOpenAI, Anthropic, Gemini, Ollama
JY_AI__PROVIDER=TemplateEngine
JY_AI__API_KEY=your_llm_api_key_here
JY_AI__MODEL=gpt-4o-mini
JY_AI__BASE_URL=

# --- Job Source API Keys / Credentials (Optional) ---
# If using dedicated authorized employer portals or partner APIs
JY_LINKEDIN__CLIENT_ID=
JY_LINKEDIN__CLIENT_SECRET=
JY_INDEED__API_KEY=
